# Runtime environment: DEV, TEST, or PROD
# DEV/TEST use SQLite and local data/ artifact paths.
# PROD uses Azure PostgreSQL and Azure Blob Storage with configuration fetched
# from Azure Key Vault.
ENV=DEV

# Azure Key Vault (required when ENV=PROD)
# Stores PostgreSQL secrets: PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
# Stores blob storage secrets: STORAGEACCOUNT, BRZECONTAINER, SILVCONTAINER, GOLDCONTAINER
# SILVCONTAINER is configured for future silver CSV artifacts.
AZURE_KEYVAULT_URL=https://violencekv.vault.azure.net/

# SQLite database file (used in DEV/TEST)
ETL_SQLITE_PATH=data/warehouse/violence_staging.db

# Source dataset (Socrata CSV export, follows a 301 redirect)
ETL_SOURCE_URL=http://www.datos.gov.co/api/v3/views/yi5j-5fe9/export.csv

# Logging
ETL_LOG_LEVEL=INFO

# Duplicate policy: "drop" keeps the first row per business key, "sum" adds cantidad
ETL_DEDUP_MODE=drop

# Bronze landing/raw root for local DEV/TEST artifact storage.
# In PROD, bronze/gold CSV artifacts are stored in Azure Blob Storage containers.
ETL_BRONZE_DIR=data/bronze

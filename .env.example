# Database target: "postgres" (warehouse) or "sqlite" (staging/tests)
ETL_DB_BACKEND=postgres

# PostgreSQL warehouse (LTS) credentials
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=violence

# SQLite staging/test database file
ETL_SQLITE_PATH=data/warehouse/violence_staging.db

# Source dataset (Socrata CSV export, follows a 301 redirect)
ETL_SOURCE_URL=http://www.datos.gov.co/api/v3/views/yi5j-5fe9/export.csv

# Logging
ETL_LOG_LEVEL=INFO

# Duplicate policy: "drop" keeps the first row per business key, "sum" adds cantidad
ETL_DEDUP_MODE=drop

# Bronze landing/raw root
ETL_BRONZE_DIR=data/bronze

# Full URL override. When set, it takes precedence over ETL_DB_BACKEND, the PG*
# variables and ETL_SQLITE_PATH (including the --sqlite-path flag). Percent-encode
# special characters in the password. Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/violence
